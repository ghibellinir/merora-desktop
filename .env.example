# Skutečné hodnoty patří do .env, který se do gitu nedostane.
# Klíč si vložíš sám. ELEVENLABS_VOICE_ID (čeština) a ELEVENLABS_VOICE_ID_EN (angličtina) doplní Merora sama podle jazyka.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Google Kalendář, Nastavení, Integrace kalendáře, Tajná adresa ve formátu iCal.
GOOGLE_CALENDAR_ICAL=
# Volitelné: místo pro počasí jako šířka,délka. Výchozí je Praha.
